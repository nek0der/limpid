          "stringUnit": {
            "state": "translated",
            "value": "エージェントの応答とコマンドの完了が表示されます。"
          }
        }
      }
    },
    "Closes every tab of this deleted worktree": {
      "comment": "Decision bar, VoiceOver: what Close All Tabs does on a worktree that was deleted",
      "localizations": {
        "ja": {
          "stringUnit": {
