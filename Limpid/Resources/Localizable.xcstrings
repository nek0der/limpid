            "value": "%2$lld 件中 %1$lld 件目"
          }
        }
      }
    },
    "All of its tabs close, and the agents running in them stop. Files on disk aren’t affected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトのタブはすべて閉じ、実行中のエージェントは停止します。ディスク上のファイルには影響しません。"
          }
        }
      }
    },
    "All of its tabs close. Files on disk aren’t affected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトのタブはすべて閉じます。ディスク上のファイルには影響しません。"
          }
        }
      }
    },
    "Removed %lld tabs with duplicate pane IDs. The selected sidebar item couldn’t be restored, so another one is selected.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
