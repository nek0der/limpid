      }
    },
    "%@ now creates a worktree without showing this sheet. This sheet now opens with %@.": {
      "comment": "New worktree sheet, once after an update: the note above it: Create Worktree Now's keys, New Worktree…'s",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ now creates a worktree without showing this sheet. This sheet now opens with %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は、このシートを表示せずにワークツリーを作成するようになりました。このシートは %2$@ で開きます。"
          }
        }
      }
    },
    "%@ now creates a worktree without showing this sheet. To open this sheet, choose New Worktree… in the File menu.": {
      "comment": "New worktree sheet, once after an update, New Worktree… with no keys; the shortcut of Create Worktree Now",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、このシートを表示せずにワークツリーを作成するようになりました。このシートは、ファイルメニューの「新規ワークツリー…」で開きます。"
          }
        }
      }
    },
    "Create Worktree Now creates a worktree without showing this sheet. This is the New Worktree… sheet.": {
      "comment": "New worktree sheet, once after an update: the note above the form when Create Worktree Now has no shortcut",
      "localizations": {
        "ja": {
          "stringUnit": {
