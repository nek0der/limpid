        }
      }
    },
    "Restarts the agent in the same conversation, not a new one": {
      "comment": "Decision bar, VoiceOver: what Resume Same Conversation does",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会話ではなく、同じ会話でエージェントを再起動します"
