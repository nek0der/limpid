      }
    },
    "Couldn’t Delete %lld Worktrees": {
      "comment": "Error after Delete Worktrees: its title; the argument is how many worktrees Git left in place",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Couldn’t Delete %lld Worktree"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Couldn’t Delete %lld Worktrees"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のワークツリーを削除できませんでした"
          }
        }
      }
    },
    "Git didn’t delete these worktrees. Delete each from its row to see why.\n\n%@": {
      "comment": "Error after Delete Worktrees: its message; the argument is the worktrees' names, one to a line",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git didn’t delete these worktrees. Delete each from its row to see why.\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git は次のワークツリーを削除しませんでした。理由は、各行の「ワークツリーを削除…」から確認できます。\n\n%@"
          }
        }
      }
    },
    "Delete the worktree “%@”?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリー「%@」を削除しますか？"
          }
        }
      },
      "comment": "Delete worktree confirmation: its title; the argument is the worktree’s name"
    },
    "Force delete the worktree “%@”?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリー「%@」を強制削除してもよろしいですか？"
          }
        }
      },
      "comment": "Force delete confirmation: its title; the argument is the worktree’s name"
    },
    "The worktree contains initialized submodules. Any uncommitted work will be lost, and local commits or stashes that exist only in its submodules may also be lost.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークツリーには初期化済みのサブモジュールがあります。未コミットの変更は失われます。サブモジュール内にだけあるローカルのコミットや stash も失われる可能性があります。"
          }
        }
      }
    },
    "The worktree has uncommitted changes, which will be lost.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークツリーには未コミットの変更があります。強制削除すると、これらの変更は失われます。"
          }
        }
      }
    },
    "Close this tab?": {
