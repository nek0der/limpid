          "stringUnit": {
            "state": "translated",
            "value": "閉じたペイン"
          }
        }
      }
    },
    "Couldn’t resume after Limpid relaunched.": {
      "comment": "Why an agent stopped: the resume Limpid typed when it relaunched did not bring the conversation back",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpid の再起動後に再開できませんでした。"
          }
        }
      }
    },
    "Not among the worktrees above. Opening it adds it there.": {
      "comment": "Sidebar, one of the other worktrees: its tooltip says it is not a working row and opening it makes it one",
      "localizations": {
