    "This can’t be undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        }
      }
    },
    "Agent responses and completed commands appear here.": {
      "comment": "Notification history, empty: what fills it",
      "localizations": {
