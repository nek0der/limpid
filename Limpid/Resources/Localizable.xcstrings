{
  "sourceLanguage": "en",
  "strings": {
    "duration.compact.hours": {
      "comment": "A turn card's duration, of a hundred minutes or more; argument: the whole hours",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld時間"
          }
        }
      }
    },
    "Latest: %@": {
      "comment": "Tooltip of a turn: its last check, after how many it ran; argument: the check as a receipt says it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新：%@"
          }
        }
      }
    },
    "Ran tests at least %lld times": {
      "comment": "Tooltip of a turn: how many checks it ran, of which some were not read; argument: how many were",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ran tests at least once"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ran tests at least %lld times"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト実行 %lld 回以上"
          }
        }
      }
    },
    "Tests (%lld failures)": {
      "comment": "Receipt: the last check failed, as did others of the turn; argument: how many failed, it included",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (%lld failure)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (%lld failures)"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト（失敗 %lld 回）"
          }
        }
      }
    },
    "Tests (filtered, %lld failures)": {
      "comment": "Receipt: the last check failed, run on part of the suite, as did others; argument: how many failed",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (filtered, %lld failure)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (filtered, %lld failures)"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト（絞り込み、失敗 %lld 回）"
          }
        }
      }
    },
    "Took %@": {
      "comment": "Tooltip of a turn: how long it ran, as a line of its own; the argument is the duration, as in 3m 05s",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Took %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所要 %@"
          }
        }
      }
    },
    "tokens.unit": {
      "comment": "A turn card: the unit after its count of tokens, as in 84K tok; kept short, as the card's column is narrow",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tok"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tok"
          }
        }
      }
    },
    "tokens.atLeast": {
      "comment": "A turn's tokens, part of the turn unread so it used more; argument: the count, as in 84,123 or 84K",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %@ tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ トークン以上"
          }
        }
      }
    },
    "Tests (after %lld failures)": {
      "comment": "Receipt: the last check, after checks of the turn that failed; argument: how many failed",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (after %lld failure)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (after %lld failures)"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト（失敗 %lld 回）"
          }
        }
      }
    },
    "Tests (filtered, after %lld failures)": {
      "comment": "Receipt: the last check, run on part of the suite, after failed checks of the turn; argument: how many failed",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (filtered, after %lld failure)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tests (filtered, after %lld failures)"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト（絞り込み、失敗 %lld 回）"
          }
        }
      }
    },
    "Ran tests %lld times": {
      "comment": "Tooltip of a turn: how many checks it ran; argument: how many",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ran tests once"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ran tests %lld times"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト実行 %lld 回"
          }
        }
      }
    },
    "%lld failed": {
      "comment": "Tooltip of a turn: how many of its checks failed, after how many it ran; argument: how many",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗 %lld 回"
          }
        }
      }
    },
    "tokens.total": {
      "comment": "A turn's tokens, the cache reads left out; argument: the count, as in 84,123 or 84K",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ トークン"
          }
        }
      }
    },
    "tokens.breakdown": {
      "comment": "Tooltip of a turn: what its token count is made of; arguments: fresh input, cache writes, output, as counts",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input %1$@ · Cache writes %2$@ · Output %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力 %1$@ · キャッシュ書き込み %2$@ · 出力 %3$@"
          }
        }
      }
    },
    "tokens.cacheReads": {
      "comment": "Tooltip of a turn: the input read from the prompt cache, left out of its token count; argument: a count",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not counted: %@ read from the cache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ読み込み %@（合計外）"
          }
        }
      }
    },
    "tokens.partial": {
      "comment": "Tooltip of a turn: its token count may be lower than what it used",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the turn could not be read, so the count may be short"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンの一部を読めなかったため、実際より少ない可能性があります"
          }
        }
      }
    },
    "duration.compact.minutes": {
      "comment": "A turn card's duration, over a minute; argument: the whole minutes",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分"
          }
        }
      }
    },
    "duration.compact.seconds": {
      "comment": "A turn card's duration, under a minute; argument: the seconds",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%llds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld秒"
          }
        }
      }
    },
    "Open Tabs": {
      "comment": "The pane strip's leading button, its tooltip and VoiceOver name, and the heading of the list of the session's tabs it opens",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Tabs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているタブ"
          }
        }
      }
    },
    "Search Tabs": {
      "comment": "Placeholder and VoiceOver name of the search field in Open Tabs",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Tabs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを検索"
          }
        }
      }
    },
    "Show Open Tabs": {
      "comment": "Menu, palette, keyboard settings: opens Open Tabs, the pane strip's list of the session's tabs",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Open Tabs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているタブを表示"
          }
        }
      }
    },
    "%lld panes": {
      "comment": "Open Tabs: how many panes a split tab has, after who runs in it (\"Shell · 2 panes\")",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pane"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld panes"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ペイン"
          }
        }
      }
    },
    "%@ isn’t on the remote, so the worktree starts from %@.": {
      "comment": "New worktree: the fetch found no such branch; the remote's branch, then the branch it starts from",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t on the remote, so the worktree starts from %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はリモートにないため、%2$@ から作成します。"
          }
        }
      }
    },
    "%lld pt": {
      "comment": "Settings, Tabs & Panes: the minimum pane size in points",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "A turn’s record is missing a snapshot, so its changes can’t be shown.": {
      "comment": "Review tab, empty: why a record that lost a snapshot shows no diff",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A turn’s record is missing a snapshot, so its changes can’t be shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンの記録にスナップショットが欠けているため、変更を表示できません。"
          }
        }
      }
    },
    "Changes in this folder can’t be tracked.": {
      "comment": "Changes panel, empty: why a folder Git does not track lists no turns",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes in this folder can’t be tracked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を追跡できません。"
          }
        }
      }
    },
    "changes.filterAll": {
      "comment": "Changes panel: the filter's entry that shows every conversation's turns",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて"
          }
        }
      }
    },
    "changes.filterHeading": {
      "comment": "Changes panel: the heading of the filter that narrows the timeline to one conversation",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話"
          }
        }
      }
    },
    "changes.filterRunning": {
      "comment": "Changes panel: the filter's section of conversations a pane of this worktree runs",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中"
          }
        }
      }
    },
    "changes.filterUnviewed": {
      "comment": "Changes panel: the filter's section of conversations with turns still to read",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unviewed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認"
          }
        }
      }
    },
    "changes.filterViewed": {
      "comment": "Changes panel: the filter's section of conversations with every turn viewed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済み"
          }
        }
      }
    },
    "Couldn’t Get the Changes": {
      "comment": "Empty state: the changes panel, Git did not answer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Get the Changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を取得できませんでした"
          }
        }
      }
    },
    "emptyState.spoken": {
      "comment": "VoiceOver, an empty list or panel: its message, then its description; arguments: the message, the description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。%2$@"
          }
        }
      }
    },
    "Ended %@": {
      "comment": "Tooltip of a turn's row: when the turn ended; argument: a clock time, as in 10:34",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ended %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了 %@"
          }
        }
      }
    },
    "git didn’t finish within %lld seconds.": {
      "comment": "Worktree-operation error — git ran past its deadline and was stopped; the number is seconds",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "git didn’t finish within %lld seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "git が %lld 秒以内に完了しませんでした。"
          }
        }
      }
    },
    "": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "%@ didn’t start. If its terminal shows an error, check that %@ is installed, then retry.": {
      "comment": "New worktree: the agent did not start; the agent's name, then its command",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn’t start. If its terminal shows an error, check that %2$@ is installed, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が起動しませんでした。ターミナルにエラーが表示されている場合は、%2$@ がインストールされているかを確認してから、もう一度お試しください。"
          }
        }
      }
    },
    "%@ is running but hasn’t reported to Limpid.": {
      "comment": "New worktree: the agent runs in its terminal and has not reported its start; the agent's name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is running but hasn’t reported to Limpid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は実行中ですが、まだ Limpid に起動を通知していません。"
          }
        }
      }
    },
    "%@ left": {
      "comment": "Time left to answer an approval in Limpid, as minutes and seconds (8:42).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り %@"
          }
        }
      }
    },
    "%@ reached": {
      "comment": "Why an agent stopped: its plan's usage limit, named as in 5-hour limit, with no reset time ahead",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reached"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に達しました"
          }
        }
      }
    },
    "%@ reached · resets %@": {
      "comment": "Why an agent stopped: its plan's usage limit, named as in 5-hour limit, and when it resets (3:40 PM, Tue 3:40 PM)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reached · resets %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に達しました · %2$@ に解除"
          }
        }
      }
    },
    "%@ starts when its tab is opened.": {
      "comment": "New worktree: the agent's tab opened behind another; the agent's name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starts when its tab is opened."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はタブを開くと起動します。"
          }
        }
      }
    },
    "%@ usage limit has reset": {
      "comment": "Notification title: the agent's plan can be used again; the argument is Claude or Codex",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usage limit has reset"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の利用上限が解除されました"
          }
        }
      }
    },
    "%@, %@": {
      "comment": "New worktree's failed stage, VoiceOver: the tag (Stopped), then the stage",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@"
          }
        }
      }
    },
    "%@, and %lld more": {
      "comment": "A list of paths cut short; arguments: the first paths, how many more",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, and %2$lld more"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ほか %2$lld 件"
          }
        }
      }
    },
