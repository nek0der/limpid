        }
      }
    },
    "Your sessions aren’t being saved: state.json can’t be read by this version and couldn’t be set aside. Move it out of the folder, then quit and reopen Limpid.": {
      "comment": "Settings, General, and the alert that the session was not restored: saving sessions is suspended",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sessions aren’t being saved: state.json can’t be read by this version and couldn’t be set aside. Move it out of the folder, then quit and reopen Limpid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを保存していません。このバージョンでは state.json を読み込めず、退避もできませんでした。state.json をフォルダの外に移動してから、Limpid を終了して再度開いてください。"
          }
        }
      }
    },
    "Your settings aren’t being saved: settings.json was written by a newer version of Limpid, so this version reads it but doesn’t write over it. Open that version to change your settings.": {
      "comment": "Settings, General, and an alert at launch: saving settings is suspended, as a newer version wrote the file",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings aren’t being saved: settings.json was written by a newer version of Limpid, so this version reads it but doesn’t write over it. Open that version to change your settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存していません。settings.json は新しいバージョンの Limpid が書き込んだため、このバージョンは読み込むだけで上書きしません。設定を変更するには、そのバージョンの Limpid を開いてください。"
          }
        }
      }
    },
    "Your settings aren’t being saved: settings.json was written by a newer version of Limpid in a form this version can’t read, so this version uses its defaults and leaves the file as it is. Open that version to change your settings.": {
      "comment": "Settings, General, and a launch alert: saving settings is suspended, as a newer version wrote an unreadable file",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings aren’t being saved: settings.json was written by a newer version of Limpid in a form this version can’t read, so this version uses its defaults and leaves the file as it is. Open that version to change your settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存していません。settings.json は新しいバージョンの Limpid がこのバージョンでは読めない形で書き込んだため、このバージョンはデフォルトの設定を使い、ファイルはそのまま残します。設定を変更するには、そのバージョンの Limpid を開いてください。"
          }
        }
      }
    },
    "Your settings aren’t being saved: settings.json can’t be read by this version and couldn’t be set aside. Move it out of the folder, then quit and reopen Limpid.": {
      "comment": "Settings, General, and an alert at launch: saving settings is suspended, as the file cannot be read",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings aren’t being saved: settings.json can’t be read by this version and couldn’t be set aside. Move it out of the folder, then quit and reopen Limpid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存していません。このバージョンでは settings.json を読み込めず、退避もできませんでした。settings.json をフォルダの外に移動してから、Limpid を終了して再度開いてください。"
          }
        }
      }
    },
