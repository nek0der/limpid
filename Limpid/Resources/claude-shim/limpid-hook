#!/bin/sh
# Limpid claude lifecycle hook — the entry point the provider calls on every
# subscribed hook event. It execs the Rust hook runtime inside the signed
# Hook Helper, so the provider's hook command never changes when the runtime
# does. The helper is the only receiver: it alone writes the turn records the
# changes panel, unread turns, and Restore Code read. A missing helper is a
# broken bundle, and we say so (`limpid_hook_helper_missing`) rather than
# record the run in a way that leaves those empty without a word.

set -u

hook_path="$0"
# Resolve the file symlink as well as its parent: Claude reaches this script
# through a no-space link in TMPDIR, and the helper lives beside the bundle.
hook_links=0
while [ -L "$hook_path" ]; do
  hook_links=$((hook_links + 1))
  [ "$hook_links" -le 16 ] || exit 0
  hook_target=$(readlink "$hook_path") || exit 0
  case "$hook_target" in
    /*) hook_path="$hook_target" ;;
    *) hook_path="$(dirname -- "$hook_path")/$hook_target" ;;
  esac
done
hook_dir="$(CDPATH='' cd -- "$(dirname -- "$hook_path")" 2>/dev/null && pwd -P)"

# LIMPID_HOOK_HELPER exists for the test suites, which run this script
# from the source tree where no bundle surrounds it.
helper="${LIMPID_HOOK_HELPER:-$hook_dir/../../MacOS/AgentIntegrationHookHelper}"
if [ ! -x "$helper" ]; then
  . "$hook_dir/../agent-shim/runtime-common.sh"
  limpid_hook_helper_missing "$helper"
fi
# One id per hook call, which a turn record applies once. Always minted
# here, never taken from the environment: a value that leaked into the
# agent's environment would give every later call the same id, and each
# would be dropped as a repeat of the first. Without `uuidgen` the id is
# empty, which the runtime reads as absent: the run is still recorded,
# only its turns are not.
LIMPID_HOOK_INVOCATION_ID="$(/usr/bin/uuidgen 2>/dev/null)"
export LIMPID_HOOK_INVOCATION_ID
exec "$helper" hook claude
