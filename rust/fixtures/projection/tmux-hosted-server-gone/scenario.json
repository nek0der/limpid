{
  "description": "A hosted run whose tmux server was killed: no hook said so, and the host's evidence that the endpoint is gone is what frees its conversation for resume.",
  "runs": [
    {
      "provider": "claude",
      "pane": "33333333-3333-4333-8333-333333333333",
      "run": "AAAAAAAA-1111-4111-8111-AAAAAAAAAAA1",
      "tmux": true,
      "tmuxHostMode": "limpidHosted",
      "replay": [
        {
          "case": "tmux-hosted",
          "payload": "0000-SessionStart.json",
          "now": "2026-09-14T12:00:00Z"
        },
        {
          "case": "tmux-hosted",
          "payload": "0001-UserPromptSubmit.json",
          "now": "2026-09-14T12:01:00Z"
        }
      ]
    }
  ]
}
