{
  "description": "A hosted run whose session ended without the user asking keeps its hint, and with tmux no longer holding the conversation it is offered for resume.",
  "runs": [
    {
      "provider": "claude",
      "pane": "11111111-1111-4111-8111-111111111111",
      "run": "AAAAAAAA-1111-4111-8111-AAAAAAAAAAA1",
      "tmux": true,
      "tmuxHostMode": "limpidHosted",
      "replay": [
        {
          "case": "tmux-hosted",
          "payload": "0000-SessionStart.json",
          "now": "2026-09-14T12:00:00Z"
        },
        {
          "case": "tmux-hosted",
          "payload": "0001-UserPromptSubmit.json",
          "now": "2026-09-14T12:01:00Z"
        },
        {
          "case": "tmux-hosted",
          "payload": "0002-Stop.json",
          "now": "2026-09-14T12:02:00Z"
        },
        {
          "case": "session-end-reasons",
          "payload": "0007-SessionEnd.json",
          "now": "2026-09-14T12:03:00Z"
        }
      ]
    }
  ]
}
