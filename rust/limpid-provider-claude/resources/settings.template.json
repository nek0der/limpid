{
  "preferredNotifChannel": "notifications_disabled",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "@@HOOK@@" }] },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "@@WORKTREE_PRETOOL_HOOK@@" }]
      }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ],
    "PostToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "@@APPROVAL_HELPER@@ permission-request claude", "timeout": 600 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "@@HOOK@@" },
        { "type": "command", "command": "@@APPROVAL_HELPER@@ question-turn-ended" }
      ] }
    ],
    "StopFailure": [
      { "hooks": [
        { "type": "command", "command": "@@HOOK@@" },
        { "type": "command", "command": "@@APPROVAL_HELPER@@ question-turn-ended" }
      ] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "@@APPROVAL_HELPER@@ question-turn-ended" }] }
    ],
    "CwdChanged": [
      { "hooks": [{ "type": "command", "command": "@@HOOK@@" }] }
    ]
  }
}
